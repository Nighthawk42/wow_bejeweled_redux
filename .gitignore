# -----------------------------------------------------------------------------
# Bejeweled for World of Warcraft
# -----------------------------------------------------------------------------

# Embedded libraries (Ace3, LibDataBroker, LibDBIcon), never committed.
# Release builds get them from the .pkgmeta externals; for local testing,
# scripts/fetch-libs.sh downloads them.
Libs/

# Large intermediate art sources, kept locally: Meshy 3D models and texture maps, the Meshy
# pilot run, and AI upscales of the concept sheets. Packs and finished art are committed.
art/custom/**/*.glb
art/custom/meshy_pilot/
art/custom/concept_upscayl_*

# Release and packaging output
*.zip
*.tar.gz
.release/

# Compiled Lua
luac.out
*.luac

# Local tooling (e.g. the wow-api MCP server installed with npm)
node_modules/
package.json
package-lock.json

# Python virtual environments used by local tools
.venv/
venv/
__pycache__/

# Editors and IDEs
.vscode/
.idea/
*.sw?
*.suo

# OS files
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
desktop.ini
